{
  "name": "tank-penetration",
  "private": true,
  "version": "1.20.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "debug": "vite --open /index.html?debug",
    "build": "tsc --noEmit && vite build",
    "build:html": "tsc --noEmit && vite build --config vite.singlefile.config.ts",
    "build:html:gift": "tsc --noEmit && vite build --config vite.singlefile.config.ts --mode gift",
    "build:html:debug": "tsc --noEmit && vite build --config vite.singlefile.config.ts --mode debug",
    "build:android": "tsc --noEmit && vite build --mode android",
    "build:apk": "npm run build:android && cap sync android && node scripts/android-apk.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "build:electron": "npm run build:desktop && node scripts/windows-electron.mjs",
    "build:webview": "npm run build:desktop && node scripts/windows-webview.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
